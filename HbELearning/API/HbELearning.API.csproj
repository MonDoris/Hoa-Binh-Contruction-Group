<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Lớp ngoài cùng: Controller, SignalR Hub, middleware và frontend tĩnh trong wwwroot.
       Tham chiếu Infrastructure là ngoại lệ ĐƯỢC PHÉP duy nhất của quy tắc phụ thuộc: Program.cs
       là nơi lắp ráp (composition root), phải biết lớp hiện thực nào gắn vào cổng nào. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HbELearning.API</RootNamespace>
    <!-- Giữ nguyên tên tệp chạy là HbELearning.dll như trước khi tách project, để
         .vscode/launch.json và kịch bản triển khai trong deploy/ không phải đổi tên tệp. -->
    <AssemblyName>HbELearning</AssemblyName>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Chạy "dotnet run" với tùy chọn project từ thư mục gốc giải pháp vẫn phải lấy thư mục làm việc là API/:
         appsettings.json, wwwroot và hbelearning.db (Sqlite, đường dẫn tương đối) đều nằm ở đây. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\HbELearning.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\HbELearning.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.*" />
    <!-- Cần cho "dotnet ef migrations" vì API là project khởi động. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
